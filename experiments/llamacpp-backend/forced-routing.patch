+int llama_moe_force_routing_mode() {
+    const char * env = getenv("LLAMA_MOE_FORCE_ROUTING");
+    if (env == nullptr || env[0] == '\0' || strcmp(env, "natural") == 0) {
+        return 0;
+    }
+    if (strcmp(env, "fixed") == 0) {
+        return 1;
+    }
+    if (strcmp(env, "disjoint") == 0) {
+        return 2;
+    }
+    GGML_ABORT("LLAMA_MOE_FORCE_ROUTING=%s: expected natural, fixed or disjoint", env);
+}
+
+void llm_graph_input_moe_route::set_input(const llama_ubatch * ubatch) {
+    // Counts passes (ubatches) since the process started, so every process -- every ncu
+    // application-replay pass -- sees the same sequence of ids.
+    static int64_t n_calls = 0;
+
+    const int64_t n_tokens = ubatch->n_tokens;
+    const int64_t k        = n_expert_used;
+
+    // Token t takes experts offset + t*k .. offset + t*k + k-1 (mod n_expert); the offset
+    // advances by the whole pass each call. fixed: experts 0..k-1 for every token.
+    const int64_t offset = mode == 2 ? (n_calls * n_tokens * k) % n_expert : 0;
+    std::vector<int32_t> data(n_tokens*k);
+    for (int64_t t = 0; t < n_tokens; ++t) {
+        for (int64_t j = 0; j < k; ++j) {
+            data[t*k + j] = mode == 2 ? (int32_t) ((offset + t*k + j) % n_expert) : (int32_t) j;
+        }
+    }
+    n_calls++;
+
+    // env LLAMA_MOE_FORCE_ROUTING_DEBUG=1: one line per pass with every token's ids, for the
+    // nsbench CPU check against the hf hook's formula
+    static const bool debug_ids = getenv("LLAMA_MOE_FORCE_ROUTING_DEBUG") != nullptr;
+    if (debug_ids) {
+        fprintf(stderr, "nsbench_moe_route call=%lld tokens=%lld out_rows=%lld ids=",
+                (long long) (n_calls - 1), (long long) n_tokens,
+                (long long) (ids_out ? ids_out->ne[1] : 0));
+        for (size_t i = 0; i < data.size(); ++i) {
+            fprintf(stderr, "%s%d", i ? "," : "", data[i]);
+        }
+        fprintf(stderr, "\n");
+    }
+
+    if (ids) {
+        GGML_ASSERT(ids->ne[1] == n_tokens);
+        ggml_backend_tensor_set(ids, data.data(), 0, data.size()*sizeof(int32_t));
+    }
+    if (ids_out) {
+        std::vector<int32_t> out;
+        out.reserve(ids_out->ne[1]*k);
+        for (int64_t t = 0; t < n_tokens; ++t) {
+            if (ubatch->output == nullptr || ubatch->output[t] || ids_out->ne[1] == n_tokens) {
+                out.insert(out.end(), data.begin() + t*k, data.begin() + (t + 1)*k);
+            }
+        }
+        GGML_ASSERT((int64_t) out.size() == ids_out->ne[1]*k);
+        ggml_backend_tensor_set(ids_out, out.data(), 0, out.size()*sizeof(int32_t));
+    }
+}
+
+bool llm_graph_input_moe_route::can_reuse(const llm_graph_params & params) {
+    bool res = true;
+    res &= mode == llama_moe_force_routing_mode();
+    res &= ids     == nullptr || ids->ne[1]     == params.ubatch.n_tokens;
+    res &= ids_out == nullptr || ids_out->ne[1] == params.n_outputs;
+    return res;
+}
